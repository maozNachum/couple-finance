# The informational shell works without configuration.
# For local auth: npm run db:start && npm run local:config
# Public browser configuration only. Replace the placeholder using the local CLI.
VITE_SUPABASE_URL=http://127.0.0.1:15421
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Never place service-role, secret, banking or provider credentials in VITE_*.
